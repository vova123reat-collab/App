# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini (https://aistudio.google.com/apikey) — server-only, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash

# Supabase service role (Project Settings → API keys → secret / service_role).
# Server-only — потрібен для кодів підключення пристрою. НІКОЛИ не додавай NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
